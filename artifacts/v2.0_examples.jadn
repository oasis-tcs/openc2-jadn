{
  "meta": {
    "package": "https://oasis-open.org/jadn/v2.0/examples",
    "description": "Example type definitions from JADN Specification"
  },

  "types": [
    ["Username", "String", ["%^[a-z][a-z0-9]{3,11}$"]],

    ["Users", "ArrayOf", ["*Username"]],

    ["Color", "Enumerated", [], "", [
      [1, "red"],
      [2, "green"],
      [3, "blue"]
    ]],

    ["Coordinate", "Record", [], "A GPS coordinate", [
      [1, "latitude", "Latitude", [], "A Number between -90 and 90 degrees"],
      [2, "longitude", "Longitude", [], "A Number between -180 and 180 degrees"]
    ]],

    ["Colors", "Enumerated", [], "", [
      [1, "red", "The color of roses"],
      [2, "green"],
      [3, "blue", "Violets"]
    ]],

    ["ColorIds", "Enumerated", ["="], "", [
      [1, "red", "The color of roses"],
      [2, "green"],
      [3, "blue", "Violets"]
    ]],

    ["Person", "Record", [], "", [
      [1, "id", "Integer", ["K"]],
      [2, "name", "String"],
      [3, "mother", "Person", ["L"]],
      [4, "father", "Person", ["L"]],
      [5, "siblings", "Person", ["[0", "]-1", "L"]],
      [6, "employer", "Organization", ["[0", "L"]]
    ]],

    ["Organization", "Record", [], "", [
      [1, "name", "String"],
      [2, "ein", "String", ["{10", "}10", "K"]],
      [3, "ceo", "Person", ["L"]]
    ]],

    ["LineItem", "Array", [], "", [
      [1, "item_id", "ItemId", ["K"], "Composite unique identifier for a line item within an order"],
      [2, "quantity", "Integer", [], "Other information about the ordered item"]
    ]],

    ["ItemId", "Array", [], "", [
      [1, "order_id", "Integer", [], "Order unique identifier"],
      [2, "product_id", "Integer", [], "Product unique identifier"]
    ]],

    ["PhoneType", "Choice", ["CO"], "", [
      [1, "predefined", "PhoneNumberTypes", [], "Pre-defined names"],
      [2, "custom", "String", ["{3", "}10"], "Any name 3-10 characters"]
    ]],

    ["PhoneNumberTypes", "Enumerated", [], "", [
      [1, "Home"],
      [2, "Cell"],
      [3, "Office"]
    ]],

    ["Connection", "Record", [], "", [
      [1, "version", "Enumerated", ["#IP-Addr"], "Source and destination versions must agree"],
      [2, "source", "IP-Addr", ["&1"]],
      [3, "destination", "IP-Addr", ["&1"]]
    ]],

    ["IP-Addr", "Choice", [], "", [
      [1, "v4", "IPv4-Addr"],
      [2, "v6", "IPc6-Addr"]
    ]],

    ["UserName", "Choice", ["CA"], "A combination of lower, upper and digits, but not all digits.", [
      [1, "a", "String", ["%^[a-zA-Z0-9]$"]],
      [2, "b", "String", ["{4", "]16"]],
      [3, "c", "String", ["N", "%^[0-9]$"]]
    ]],

    ["Name1", "Choice", ["CO"], "Extend equivalent: 2915, a34c, D72F are valid.  g16H is not.", [
      [1, "a", "String", ["%^[a-z0-9]$"]],
      [2, "b", "String", ["%^[A-Z0-9]$"]]
    ]],

    ["Name2", "Choice", ["CA"], "Restrict equivalent: 2915 is valid.  a34c, D72F, g16H are not.", [
      [1, "a", "String", ["%^[a-z0-9]$"]],
      [2, "b", "String", ["%^[A-Z0-9]$"]]
    ]],

    ["Entity", "Record", ["a"], "Base type, cannot be instantiated", [
      [1, "id", "Integer"],
      [2, "name", "String", ["[0"]]
    ]],

    ["Person2", "Record", ["eEntity"], "Add email address", [
      [3, "email", "String", ["/email", "[0"]]
    ]],

    ["AnonymousPerson", "Record", ["f", "rPerson2"], "", [
      [2, "name", "String", ["[0", "]0"]]
    ]],

    ["Colors1", "Enumerated", [], "Primary colors", [
      [5, "red"],
      [3, "green"],
      [16, "blue"]
    ]],

    ["Colors2", "Enumerated", ["eColors1"], "Primary and secondary colors", [
      [2, "yellow"],
      [7, "magenta"],
      [6, "cyan"]
    ]],

    ["Amount", "Integer", ["/d2"], "Integer 152 represents an application value of 1.52, changing currency unit from US dollars to cents"],

    ["ObjectId", "Array", ["/tag-uuid"], "", [
      [1, "prefix", "String", [], "Type Prefix"],
      [2, "uuid", "UUID", [], "Unique Identifier"]
    ]],

    ["Timestamp", "Integer", ["/date-time"], "1727877600 seconds         = 2024-10-02T15:00:00Z"],

    ["Timestamp-ms", "Integer", ["/date-time", "/d3"], "1727877600000 milliseconds = 2024-10-02T15:00:00.000Z"],

    ["Coordinate2", "Record", [], "A GPS coordinate", [
      [1, "latitude", "Coordinate2.latitude", [], "A Number between -90 and 90 degrees"],
      [2, "longitude", "Coordinate2.longitude", [], "A Number between -180 and 180 degrees"]
    ]],

    ["Coordinate2.latitude", "Number", ["w-90.", "y90."], "A Number between -90 and 90 degrees"],

    ["Coordinate2.longitude", "Number", ["y-180.", "z180."], "A Number between -180 and 180 degrees"],

    ["Roster", "Record", [], "", [
      [1, "org_name", "String"],
      [2, "members", "Member", ["[0", "]-1"], "Optional and repeated: minOccurs=0, maxOccurs=MAX_DEFAULT"]
    ]],

    ["Roster2", "Record", [], "", [
      [1, "org_name", "String"],
      [2, "members", "Roster2.members", ["[0"], "Optional: minOccurs=0, no maxOccurs"]
    ]],

    ["Roster2.members", "ArrayOf", ["*Member", "{1"], "Tool-generated array: minLength=1, no maxLength"],

    ["Roster3", "Record", [], "", [
      [1, "org_name", "String"],
      [2, "members", "Members", [], "members field is required: default minOccurs = 1, maxOccurs = 1"]
    ]],

    ["Members", "ArrayOf", ["*Member"], "Explicitly-defined array: no minLength, no maxLength"],

    ["Pixel", "Map", [], "", [
      [1, "red", "Integer"],
      [2, "green", "Integer"],
      [3, "blue", "Integer"]
    ]],

    ["Channel", "Enumerated", ["#Pixel"], "Derived Enumerated type"],

    ["ChannelMask", "ArrayOf", ["*#Pixel"], "ArrayOf(derived enumeration)"],

    ["Channel2", "Enumerated", [], "", [
      [1, "red"],
      [2, "green"],
      [3, "blue"]
    ]],

    ["ChannelMask2", "ArrayOf", ["*Channel"]],

    ["Channel3", "Enumerated", [], "", [
      [1, "red"],
      [2, "green"],
      [3, "blue"]
    ]],

    ["Pixel3", "MapOf", ["+Channel3", "*Integer"]],

    ["BOM", "Record", [], "", [
      [1, "bomFormat", "BomFormat"],
      [2, "version", "String"],
      [3, "metadata", "Metadata"]
    ]],

    ["BomFormat", "Enumerated", [], "", [
      [1, "cyclonedx"],
      [2, "spdx"]
    ]],

    ["Metadata", "Record", [], "", [
      [1, "timestamp", "String", ["/date-time"]],
      [2, "tools", "Tool", ["]-1"]]
    ]],

    ["Tool", "Record", ["{1"], "", [
      [1, "vendor", "String", ["[0"]],
      [2, "name", "String", ["[0"]]
    ]],

    ["BomList", "Enumerated", [">BOM"]],

    ["BomList2", "Enumerated", [], "", [
      [1, "bomFormat"],
      [2, "version"],
      [3, "metadata/timestamp"],
      [4, "metadata/tools/#/vendor"],
      [5, "metadata/tools/#/name"]
    ]],

    ["Person3", "Record", [], "", [
      [1, "name", "String"],
      [2, "id", "Integer"],
      [3, "email", "String", ["[0"]]
    ]],

    ["FieldID", "Integer", ["y0"]],

    ["Option", "String", ["ya", "zz", "{1"], "** Need JIDL Syntax **"],

    ["Product", "Choice", [], "Discriminated union", [
      [1, "furniture", "Furniture"],
      [2, "appliance", "Appliance"],
      [3, "software", "Software"]
    ]],

    ["Dept", "Enumerated", [], "Explicit Tag values derived from the Choice", [
      [1, "furniture"],
      [2, "appliance"],
      [3, "software"]
    ]],

    ["Software", "String", ["/uri"]],

    ["Stock1", "Record", [], "Discriminated union with intrinsic tag", [
      [1, "quantity", "Integer"],
      [2, "product", "Product", [], "Value = Map with one key/value"]
    ]],

    ["Stock2", "Record", [], "Container with explicitly-tagged discriminated union", [
      [1, "dept", "Dept", [], "Tag = one key from Choice"],
      [2, "quantity", "Integer"],
      [3, "product", "Product", ["&1"], "Choice specifying an explicit tag field"]
    ]],

    ["Hashes", "Map", ["{1"], "Multiple discriminated unions with intrinsic tags is a Map", [
      [1, "md5", "Binary", ["/x", "{16", "}16", "[0"]],
      [2, "sha1", "Binary", ["/x", "{20", "}20", "[0"]],
      [3, "sha256", "Binary", ["/x", "{32", "}32", "[0"]]
    ]],

    ["Hashes2", "ArrayOf", ["*HashVal"], "Multiple discriminated unions with explicit tags is an Array"],

    ["HashVal", "Record", [], "", [
      [1, "algorithm", "Enumerated", ["#HashAlg"], "Tag - one key from Choice"],
      [2, "value", "HashAlg", ["&1"], "Value selected from Choice by 'algorithm' field"]
    ]],

    ["HashAlg", "Choice", [], "", [
      [1, "md5", "Binary", ["/x", "{16", "}16"]],
      [2, "sha1", "Binary", ["/x", "{20", "}20"]],
      [3, "sha256", "Binary", ["/x", "{32", "}32"]]
    ]],

    ["Member", "Record", [], "", [
      [1, "name", "String"],
      [2, "email", "String", ["/email"]]
    ]],

    ["Member2", "Record", [], "", [
      [1, "name", "String"],
      [2, "email", "Member2.email"]
    ]],

    ["Member2.email", "String", ["/email"], "Tool-generated type definition."]
  ]
}
