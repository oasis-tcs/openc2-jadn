     package: "https://oasis-open.org/jadn/v2.0/examples"
 description: "Example type definitions from JADN Specification"

Username = String{pattern="^[a-z][a-z0-9]{3,11}$"}

Users = ArrayOf(Username)

Color = Enumerated
   1 red
   2 green
   3 blue

Coordinate = Record                              // A GPS coordinate
   1 latitude         Latitude                   // A Number between -90 and 90 degrees
   2 longitude        Longitude                  // A Number between -180 and 180 degrees

Colors = Enumerated
   1 red                                         // The color of roses
   2 green
   3 blue                                        // Violets

ColorIds = Enumerated#
   1                                             // red:: The color of roses
   2                                             // green::
   3                                             // blue:: Violets

Person = Record
   1 id               Key(Integer)
   2 name             String
   3 mother           Link(Person)
   4 father           Link(Person)
   5 siblings         Link(Person) [0..*]
   6 employer         Link(Organization) optional

Organization = Record
   1 name             String
   2 ein              Key(String{10..10})
   3 ceo              Link(Person)

LineItem = Record
   1 item_id          Key(ItemId)                // Composite unique identifier for a line item within an order
   2 quantity         Integer                    // Other information about the ordered item

ItemId = Array
   1  Integer                                    // order_id:: Order unique identifier
   2  Integer                                    // product_id:: Product unique identifier

PhoneType = Choice(anyOf)
   1  PhoneNumberTypes                           // predefined:: Pre-defined names
   2  String{3..10}                              // custom:: Any name 3-10 characters

PhoneNumberTypes = Enumerated
   1 Home
   2 Cell
   3 Office

Connection = Record
   1 version          Enumerated(Enum[IP-Addr])  // Source and destination versions must agree
   2 source           IP-Addr(TagId[version])
   3 destination      IP-Addr(TagId[version])

IP-Addr = Choice
   1 v4               IPv4-Addr
   2 v6               IPc6-Addr

UserName = Choice(allOf)                         // A combination of lower, upper and digits, but not all digits.
   1  String{pattern="^[a-zA-Z0-9]$"}            // a::
   2  String{4..*} [1..16]                       // b::
   3  !String{pattern="^[0-9]$"}                 // c::

Name1 = Choice(anyOf)                            // Extend equivalent: 2915, a34c, D72F are valid.  g16H is not.
   1  String{pattern="^[a-z0-9]$"}               // a::
   2  String{pattern="^[A-Z0-9]$"}               // b::

Name2 = Choice(allOf)                            // Restrict equivalent: 2915 is valid.  a34c, D72F, g16H are not.
   1  String{pattern="^[a-z0-9]$"}               // a::
   2  String{pattern="^[A-Z0-9]$"}               // b::

Entity = Record abstract                         // Base type, cannot be instantiated
   1 id               Integer
   2 name             String optional

Person2 = Record extends(Entity)                 // Add email address
   3 email            String /email optional

AnonymousPerson = Record final restricts(Person2)
   2 name             String [0]

Colors1 = Enumerated                             // Primary colors
   5 red
   3 green
  16 blue

Colors2 = Enumerated extends(Colors1)            // Primary and secondary colors
   2 yellow
   7 magenta
   6 cyan

Amount = Integer /d2                             // Integer 152 represents an application value of 1.52, changing currency unit from US dollars to cents

ObjectId = Array /tag-uuid
   1  String                                     // prefix:: Type Prefix
   2  UUID                                       // uuid:: Unique Identifier

Timestamp = Integer /date-time                   // 1727877600 seconds         = 2024-10-02T15:00:00Z

Timestamp-ms = Integer /date-time                // 1727877600000 milliseconds = 2024-10-02T15:00:00.000Z

Timestamp2 = String /date-time

Coordinate2 = Record                             // A GPS coordinate
   1 latitude         Coordinate2.latitude       // A Number between -90 and 90 degrees
   2 longitude        Coordinate2.longitude      // A Number between -180 and 180 degrees

Coordinate2.latitude = Number=(90.0, *]          // A Number between -90 and 90 degrees

Coordinate2.longitude = Number=[-180.0, 180.0]   // A Number between -180 and 180 degrees

Roster = Record
   1 org_name         String
   2 members          Member [0..*]              // Optional and repeated: minOccurs=0, maxOccurs=MAX_DEFAULT

Roster2 = Record
   1 org_name         String
   2 members          Roster2.members optional   // Optional: minOccurs=0, maxOccurs (1)

Roster2.members = ArrayOf(Member){1..*}          // Tool-generated array: minLength=1, no maxLength

Roster3 = Record
   1 org_name         String
   2 members          Members                    // members field is required: default minOccurs (1), maxOccurs (1)

Members = ArrayOf(Member)                        // Explicitly-defined array: no minLength, no maxLength

Pixel = Map
   1 red              Integer
   2 green            Integer
   3 blue             Integer

Channel = Enumerated(Enum[Pixel])                // Derived Enumerated type

ChannelMask = ArrayOf(Enum[Pixel])               // ArrayOf(derived enumeration)

Channel2 = Enumerated
   1 red
   2 green
   3 blue

ChannelMask2 = ArrayOf(Channel)

Channel3 = Enumerated
   1 red
   2 green
   3 blue

Pixel3 = MapOf(Channel3, Integer)

BOM = Record
   1 bomFormat        BomFormat
   2 version          String
   3 metadata         Metadata

BomFormat = Enumerated
   1 cyclonedx
   2 spdx

Metadata = Record
   1 timestamp        String /date-time
   2 tools            Tool [1..*]

Tool = Record{1..*}
   1 vendor           String optional
   2 name             String optional

BomList = Enumerated(Pointer[BOM])

BomList2 = Enumerated
   1 bomFormat
   2 version
   3 metadata/timestamp
   4 metadata/tools/#/vendor
   5 metadata/tools/#/name
